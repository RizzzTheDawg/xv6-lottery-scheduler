@@ -149,3 +151,20 @@ syscall(void)
     p->trapframe->a0 = -1;
   }
 }
+uint64
+sys_settickets(void)
+{
+  int n;
+  argint(0, &n);
+
+  // Validate positive integer[cite: 1]
+  if(n <= 0)
+    return -1;
+
+  struct proc *p = myproc();
+  acquire(&p->lock);
+  p->tickets = n;
+  release(&p->lock);
+
+  return 0;
+}
